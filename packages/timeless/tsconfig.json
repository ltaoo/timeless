{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "jsx": "preserve",
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@timeless/base": ["../base/src/index.ts"],
      "@timeless/reactive": ["../reactive/src/index.ts"],
      "@timeless/utils": ["../utils/src/index.ts"],
      "@timeless/ui": ["../ui/src/index.ts"],
      "@timeless/kit": ["../kit/src/index.ts"],
      "@timeless/types": ["../types/src/index.ts"],
      "@timeless/icons": ["../icons/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
