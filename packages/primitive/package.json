{
  "name": "@timeless/inner-primitive",
  "version": "0.33.0",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/update-exports.js && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "peerDependencies": {
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@timeless/inner-base": "workspace:^",
    "@timeless/inner-reactive": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.esm.js",
      "require": "./dist/data/index.js"
    },
    "./event": {
      "types": "./dist/event/index.d.ts",
      "import": "./dist/event/index.esm.js",
      "require": "./dist/event/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.esm.js",
      "require": "./dist/layout/index.js"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.esm.js",
      "require": "./dist/style/index.js"
    }
  },
  "devDependencies": {
    "typedoc": "^0.28.19"
  }
}
