{
  "name": "@timeless/icons",
  "version": "0.28.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./asn": {
      "types": "./dist/asn/index.d.ts",
      "import": "./dist/asn/index.js",
      "require": "./dist/asn/index.js",
      "default": "./dist/asn/index.js"
    },
    "./asn/*": {
      "types": "./dist/asn/*.d.ts",
      "import": "./dist/asn/*.js",
      "require": "./dist/asn/*.js",
      "default": "./dist/asn/*.js"
    },
    "./file/*.svg": {
      "import": "./src/file/*.svg",
      "default": "./src/file/*.svg"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/build.mjs && tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "svgo": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
