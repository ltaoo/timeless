{
  "version": "1.0.0",
  "status": "active",
  "updated_at": "2026-10-03",
  "agent": {
    "skill": "design",
    "instructions": "Read this contract before UI edits; use its tokens, update new components, and verify implementation against the contract."
  },
  "sources": [
    "THEME_DESIGN.md",
    "src/tokens.json",
    "../../../lucky/.design",
    "../../../lucky/design-system/DESIGN.md"
  ],
  "intent": {
    "reference": "Screenshot-derived Lucky Mini Program home, account and ordering pages.",
    "treatment": "utilitarian",
    "signature": "Large photographic campaign image, deep-blue actions, pale profile header, orange prices, floating pill navigation."
  },
  "themes": {
    "single": "light"
  },
  "policy": {
    "if_missing": "invent_with_note",
    "hierarchy": [
      "typography",
      "spacing",
      "contrast",
      "color"
    ]
  },
  "constraints": {
    "always": [
      "Use shared Timeless primitives and stores",
      "Scope CSS under data-tt-style=lucky",
      "Use semantic aliases in components",
      "Preserve screenshot token values",
      "Keyboard focus and reduced motion"
    ],
    "never": [
      "External fonts or CDN dependencies",
      "Browser automation",
      "Invent official dark-theme values",
      "Import another theme package"
    ]
  },
  "tokens": {
    "lucky": {
      "color": {
        "brand": "#0921a4",
        "brandSoft": "#f3f4fe",
        "page": "#f5f5f5",
        "surface": "#ffffff",
        "profile": "#e6e9f6",
        "text": "#333333",
        "textStrong": "#111111",
        "textSecondary": "#666666",
        "textMuted": "#999999",
        "line": "#eeeeee",
        "price": "#ff5427",
        "gold": "#c1a174",
        "goldSoft": "#f1e2c7",
