<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="Todo" Width="400" Height="500">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox x:Name="CategoryComboBox" Width="100" SelectedIndex="0">
                <ComboBoxItem Content="work"/>
                <ComboBoxItem Content="daily"/>
            </ComboBox>
            <TextBox x:Name="InputTextBox" Width="180" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
            <Button x:Name="AddButton" Width="44" Margin="8,0,0,0">
                <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z" 
                      Fill="Black" 
                      Width="24" Height="24" 
                      Stretch="Uniform"/>
            </Button>
        </StackPanel>
        
        <ListBox x:Name="TodoListBox" Grid.Row="1"/>
    </Grid>
</Window>