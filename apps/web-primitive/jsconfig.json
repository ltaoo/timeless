{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "baseUrl": "./..",
    "checkJs": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["@timeless/inner-types"]
  },
  "include": [
    "src/**/*.js",
    "types/global.d.ts",
    "types/index.d.ts",
    "src/**/*.d.ts"
  ]
}
