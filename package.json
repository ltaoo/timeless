{
  "name": "timeless-monorepo",
  "version": "0.33.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js --prod && node scripts/analyze-build.js && node scripts/smoke-test-build.js",
    "dev": "node scripts/dev.js",
    "build:whole": "pnpm --filter \"./packages/*\" --filter \"!./packages/solidjs\" --filter \"!./packages/vue\" -r run build -- --whole",
    "build:lite": "pnpm --filter \"./packages/lite\" -r run build",
    "build:icons": "pnpm -C packages/icons run build",
    "build:types": "pnpm -C packages/types run generate",
    "test": "pnpm -r run test",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.1.1",
    "prettier": "^3.2.5",
    "terser": "^5.31.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.0-beta.16",
    "vite-plugin-dts": "^4.0.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^4.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "pnpm": {
    "overrides": {
      "@microsoft/api-extractor": "7.58.1"
    }
  }
}
